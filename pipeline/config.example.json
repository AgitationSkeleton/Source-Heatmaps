{
  "secrets": "../secrets/db.json",
  "site_src": "../site",
  "site_dir": "/var/www/heatmaps",
  "cache_dir": "../cache",
  "log_dir": "../logs",
  "edge_limit": 60000,
  "games": {
    "tf": {
      "name": "Team Fortress 2",
      "engine": "source",
      "content": [
        "/srv/tf2/tf"
      ],
      "team_colors": {
        "2": "red",
        "3": "blue"
      }
    },
    "tf2classified": {
      "name": "Team Fortress 2 Classified",
      "engine": "source",
      "content": [
