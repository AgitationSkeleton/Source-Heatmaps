    "hl2mp": {
      "name": "Half-Life 2: Deathmatch",
      "engine": "source",
      "content": [
        "/srv/hl2dm/hl2mp"
      ],
      "team_colors": {
        "0": "purple",
        "2": "blue",
        "3": "red"
      }
    }
  },
  "icons": {
    "_comment": "Point these at your own installs. VTF files loose ({'file': ...}) or inside a VPK ({'vpk': '..._dir.vpk', 'path': 'materials/hud/...'}). The nine TF2 classes need TF2's texture VPK data or any mod that ships loose copies.",
    "scout": [
      {
        "vpk": "/path/to/tf/tf2_textures_dir.vpk",
        "path": "materials/hud/leaderboard_class_scout.vtf"
      }
    ],
    "soldier": [
      {
        "vpk": "/path/to/tf/tf2_textures_dir.vpk",
